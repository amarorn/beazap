APP_NAME=BeaZap
DEBUG=false

# PostgreSQL — use o banco do docker-compose (postgres na porta 5434)
DATABASE_URL=postgresql://beazap:beazap@localhost:5434/beazap

# SQLite (apenas desenvolvimento local, sem Docker)
# DATABASE_URL=sqlite:///./beazap.db

# Chave secreta da aplicacao
SECRET_KEY=troque-esta-chave-em-producao

# WPPConnect Server (porta no host; dentro do container sempre 21465)
# Se docker-compose falhar com "address already in use" na 21465, outro processo ja usa a porta.
# Opcao A: parar o que usa 21465 (ex.: container wpp-server ou npm run dev no wppconnect-server)
# Opcao B: WPPCONNECT_PORT=21466 e WPPCONNECT_API_URL=http://localhost:21466
# Padrao 21466 no compose evita conflito com npm run dev do wppconnect-server na 21465
WPPCONNECT_PORT=21466
WPPCONNECT_API_URL=http://localhost:21466
WPPCONNECT_API_KEY=
# Deve ser igual ao SECRET_KEY do servico wppconnect no docker-compose (default: THISISMYSECURETOKEN)
WPPCONNECT_SECRET=THISISMYSECURETOKEN
# URL que o container WPPConnect usa para POSTar eventos (QR, etc.). O path final = nome da sessao.
# Se a instancia no painel tem instance_name=teste, use:
# WPPCONNECT_WEBHOOK_URL=http://host.docker.internal:8000/webhook/teste
# Depois: docker compose up -d wppconnect --force-recreate
# WPPCONNECT_WEBHOOK_URL=http://host.docker.internal:8000/webhook/teste

# Imagem Docker do WPPConnect (padrao: build local wppconnect-server-beazap:latest).
# Se publicou no Docker Hub: WPPCONNECT_IMAGE=seuusuario/wppconnect-server-beazap:latest
# WPPCONNECT_IMAGE=wppconnect-server-beazap:latest

# Kafka/Redpanda (Fase 1 event-driven)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DEFAULT_TENANT_ID=1

# Webhook secret opcional
WEBHOOK_SECRET=

# CORS: origens extras para deploy (ex: https://abc.ngrok-free.app)
# CORS_ORIGINS=https://seu-frontend.ngrok-free.app

# LLM para analise de conversas — escolha o provedor: "anthropic" ou "openai"
LLM_PROVIDER=anthropic

# Anthropic Claude (claude-haiku-4-5-20251001)
ANTHROPIC_API_KEY=sua-chave-aqui

# OpenAI (gpt-4o-mini)
OPENAI_API_KEY=sua-chave-aqui

# SMTP para envio de QR Code por email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
