APP_NAME=BeaZap
DEBUG=false

# PostgreSQL — use o banco do docker-compose (postgres na porta 5434)
# O init-postgres.sh cria o usuário e banco beazap na primeira subida
DATABASE_URL=postgresql://beazap:beazap@localhost:5434/beazap

# SQLite (apenas desenvolvimento local, sem Docker)
# DATABASE_URL=sqlite:///./beazap.db

# Chave secreta da aplicação
SECRET_KEY=troque-esta-chave-em-producao

# Evolution API (configuração global, pode ser sobrescrita por instância)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=beazap-secret-2026
# Evolution Manager (Docker, mesmo servidor) — URL que o navegador usa para abrir o Manager
# Frontend usa em "Enviar pelo Evolution Manager" quando o envio falha (ex.: contato LID)
NEXT_PUBLIC_EVOLUTION_MANAGER_URL=http://localhost:8081
# Em produção no mesmo servidor: use o host público, ex. https://gerencia.seudominio.com ou https://seudominio.com:8081

# Opcional: banco Postgres da Evolution (para registro automático de contatos LID e retry de envio)
# EVOLUTION_DATABASE_URI=postgresql://evolution:evolution123@localhost:5434/evolution

# Webhook secret opcional
WEBHOOK_SECRET=

# CORS: origens extras para deploy (ex: https://abc.ngrok-free.app)
# CORS_ORIGINS=https://seu-frontend.ngrok-free.app

# LLM para análise de conversas — escolha o provedor: "anthropic" ou "openai"
LLM_PROVIDER=anthropic

# Anthropic Claude (claude-haiku-4-5-20251001)
ANTHROPIC_API_KEY=sua-chave-aqui

# OpenAI (gpt-4o-mini)
OPENAI_API_KEY=sua-chave-aqui
